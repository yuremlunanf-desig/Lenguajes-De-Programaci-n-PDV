from tkinter import *

# 1. Crear la ventana principal (Raíz / Root)
raiz = Tk()

# 2. Configurar el título de la ventana
raiz.title("Ventana de Pruebas - Video 1")

# 3. Controlar el redimensionamiento (ancho, alto)
raiz.resizable(True, False)

# 4. Establecer las dimensiones iniciales
raiz.geometry("650x350")

# 5. Configurar el color de fondo de la ventana
raiz.config(bg="purple")

# 6. Cambiar el ícono de la ventana (Opcional)
